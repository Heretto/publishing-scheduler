# ── hop-core required ──────────────────────────────────────────────────────────
APP_SECRET_KEY=change-me-32-chars-minimum-secret
JWT_SECRET_KEY=change-me-32-chars-minimum-jwt-key
ENCRYPTION_KEY=change-me-16-chars
DATABASE_URL=sqlite:///./data/scheduler.db

# Redis is reserved for future rate-limiting — leave blank for now
REDIS_URL=

# ── hop-core optional ──────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=false
CORS_ORIGINS=http://localhost:4200
COOKIE_SECURE=false  # MUST be true in any non-localhost deployment
SINGLE_ORG_MODE=true
SINGLE_ORG_SLUG=publishing-scheduler
FRONTEND_BASE_URL=http://localhost:4200

# SMTP (required for password reset and invitations)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Publishing Scheduler

# SSO (optional)
GOOGLE_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# ── Heretto API ────────────────────────────────────────────────────────────────
# HERETTO_HOST: full domain (e.g. acme.heretto.com or cms.acme.com for self-hosted).
# All API URLs (publishing, CCMS REST, search) are derived from this value.
HERETTO_HOST=acme.heretto.com
# HERETTO_ORG: org identifier used in CCMS content paths.
# Usually equals the subdomain of HERETTO_HOST, but may differ on some instances
# (e.g. host "demo-nxt.heretto.com" with org "jorsek").
HERETTO_ORG=acme
HERETTO_USERNAME=
HERETTO_PASSWORD=
HERETTO_BRANCH=master
HERETTO_REPOSITORY=content

# ── Scheduler ─────────────────────────────────────────────────────────────────
SCHEDULER_MAX_CONSECUTIVE_FAILURES=5
JOB_RETENTION_DAYS=90

# ── Retry ─────────────────────────────────────────────────────────────────────
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY_MS=1000
RETRY_MAX_DELAY_MS=30000
RETRY_BACKOFF_MULTIPLIER=2.0

# ── Job execution ──────────────────────────────────────────────────────────────
JOB_TIMEOUT_SECONDS=1800  # 30 minutes
