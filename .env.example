# Copy to .env and fill in. Names match the settings in backend/settings.py
# (AppSettings) and hop-core's HopCoreSettings; anything omitted falls back to
# the default in code.

# ============================================
# REQUIRED — no defaults, the app will not start without these
# ============================================
# Generate each one separately, e.g.:  openssl rand -hex 32
APP_SECRET_KEY=
JWT_SECRET_KEY=
ENCRYPTION_KEY=          # passphrase, minimum 16 characters

# Required, but docker compose sets it to the container volume path for you.
# Only set this for a non-Docker run, e.g. sqlite:///./data/scheduler.db
# DATABASE_URL=

# ============================================
# HERETTO CREDENTIALS
# ============================================
# HERETTO_HOST: full domain of the Heretto instance.
#   Standard SaaS:   acme.heretto.com
#   Self-hosted:     cms.acme.com
HERETTO_HOST=acme.heretto.com
# HERETTO_ORG: org identifier used in CCMS content paths
#   (/db/organizations/{org}/repositories/...).
#   Usually equals the subdomain of HERETTO_HOST, but some instances differ
#   (e.g. host "demo-nxt.heretto.com" may have org "jorsek").
#   The API base URL, CCMS REST URL, and search URL are all derived from HERETTO_HOST.
HERETTO_ORG=acme
HERETTO_USERNAME=your-username
HERETTO_PASSWORD=your-password
HERETTO_BRANCH=master
HERETTO_REPOSITORY=content

# ============================================
# SERVER
# ============================================
APP_ENV=production       # or 'development'
APP_DEBUG=false
# Comma-separated. In production set this to your real origin(s).
CORS_ORIGINS=http://localhost:4200
# Used in links inside outbound email (password reset, invitations).
FRONTEND_BASE_URL=http://localhost:4200
# COOKIE_SECURE=true     # enable when serving over HTTPS
# COOKIE_DOMAIN=

# ============================================
# SCHEDULER & JOBS (optional)
# ============================================
SCHEDULER_MAX_CONSECUTIVE_FAILURES=5
JOB_RETENTION_DAYS=90
JOB_TIMEOUT_SECONDS=1800

# ============================================
# RETRY (optional)
# ============================================
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY_MS=1000
RETRY_MAX_DELAY_MS=30000
RETRY_BACKOFF_MULTIPLIER=2

# ============================================
# AUTH TOKENS (optional)
# ============================================
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
# JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# SSO (optional) — the login page shows only configured providers.
# Leave a provider's variables unset to hide it.
# ============================================
# GOOGLE_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_TENANT_ID=common      # 'common' allows any Microsoft account
# OAUTH_REDIRECT_BASE_URL=
# SSO_ONLY=false                        # true disables username/password login
# ALLOWED_EMAIL_DOMAINS=                # comma-separated, e.g. heretto.com

# ============================================
# EMAIL / SMTP (optional) — needed for password reset and invitations
# ============================================
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# SMTP_FROM_NAME=Hop Platform
# SMTP_USE_TLS=true
